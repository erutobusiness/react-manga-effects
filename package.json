{
  "name": "react-manga-effects",
  "version": "0.1.8",
  "description": "Lightweight React components for manga/anime-style visual effects - iris wipes and speed lines",
  "keywords": [
    "react",
    "manga",
    "anime",
    "effects",
    "iris-wipe",
    "speed-lines",
    "focus-lines",
    "transition",
    "animation",
    "typescript"
  ],
  "homepage": "https://github.com/erutobusiness/react-manga-effects#readme",
  "bugs": {
    "url": "https://github.com/erutobusiness/react-manga-effects/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erutobusiness/react-manga-effects.git"
  },
  "license": "MIT",
  "author": "erutobusiness",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./dist/style.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "typecheck:next": "node node_modules/typescript-7/bin/tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@storybook/react": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^27.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^10.5.7",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^5.0.0",
    "vitest": "^4.1.10"
  }
}
